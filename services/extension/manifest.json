{
  "manifest_version": 3,
  "name": "Video Watch Tracker",
  "version": "1.0",
  "description": "Monitors video watch activity and publishes metadata to a processing pipeline.",

  "permissions": [
    "storage",
    "activeTab"
  ],

  "host_permissions": [
    "https://www.youtube.com/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/shorts/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_popup": "popup.html"
  }
}